# --- API Gemini standard (Google AI Studio) ---
# Obtenez votre clé sur : https://aistudio.google.com/
GEMINI_API_KEY=votre_cle_api_gemini
GEMINI_MODEL_NAME=gemini-2.0-flash

# --- Configuration Vertex AI (Alternative GCP) ---
# Décommentez ces lignes pour utiliser Vertex AI à la place de l'API standard
# USE_VERTEX_AI=true
# VERTEX_PROJECT_ID=votre-gcp-project-id
# VERTEX_LOCATION=us-central1

# --- Paramètres de Détection ---
# Seuil de poids cumulé pour déclencher la création d'un cours (par défaut : 3.0)
CLUSTERING_THRESHOLD=3.0

# Vitesse de dépréciation journalière des anciennes lacunes (0.05 = ~14 jours de demi-vie)
DECAY_RATE_LAMBDA=0.05

# --- Configuration du Mode Thinking ---
# Active ou désactive le mode réflexion de Gemini 2.0
ENABLE_THINKING=true
THINKING_MODEL=gemini-2.0-flash-thinking-exp
